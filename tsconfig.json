{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "node",
      "vinext/types"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/link": [
        "./web/link.tsx"
      ],
      "next/navigation": [
        "./web/navigation.ts"
      ]
    }
  },
  "include": [
    "web",
    "components",
    "hooks",
    "lib"
  ],
  "exclude": [
    "lib/admin-auth.ts",
    "lib/operations.ts"
  ]
}